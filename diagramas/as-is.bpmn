<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_AS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Venta de comida en el carrito universitario (AS-IS)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_est" name="Estudiante">
        <bpmn:flowNodeRef>Ev_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_caminar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_fila</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_indicar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_recibir</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ven" name="Vendedor del carrito">
        <bpmn:flowNodeRef>Ta_revisar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_alternativa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_alternativa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_noventa</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_cobrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ta_registrar</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Ev_inicio" name="Termina la clase y quiere comprar">
      <bpmn:outgoing>Fa_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Ta_caminar" name="Caminar hasta el carrito">
      <bpmn:incoming>Fa_01</bpmn:incoming>
      <bpmn:outgoing>Fa_02</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Ta_fila" name="Esperar en la fila">
      <bpmn:incoming>Fa_02</bpmn:incoming>
      <bpmn:outgoing>Fa_03</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Ta_indicar" name="Indicar el pedido al vendedor">
      <bpmn:incoming>Fa_03</bpmn:incoming>
      <bpmn:outgoing>Fa_04</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Ta_revisar" name="Revisar el stock en el software de ventas">
      <bpmn:incoming>Fa_04</bpmn:incoming>
      <bpmn:outgoing>Fa_05</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gw_stock" name="¿Hay stock del producto?">
      <bpmn:incoming>Fa_05</bpmn:incoming>
      <bpmn:outgoing>Fa_06</bpmn:outgoing>
      <bpmn:outgoing>Fa_07</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:manualTask id="Ta_alternativa" name="Informar que está agotado y ofrecer una alternativa">
      <bpmn:incoming>Fa_07</bpmn:incoming>
      <bpmn:outgoing>Fa_13</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:exclusiveGateway id="Gw_alternativa" name="¿Acepta la alternativa?">
      <bpmn:incoming>Fa_13</bpmn:incoming>
      <bpmn:outgoing>Fa_14</bpmn:outgoing>
      <bpmn:outgoing>Fa_12</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:endEvent id="Ev_noventa" name="Venta no concretada">
      <bpmn:incoming>Fa_12</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:manualTask id="Ta_preparar" name="Preparar el pedido">
      <bpmn:incoming>Fa_06</bpmn:incoming>
      <bpmn:incoming>Fa_14</bpmn:incoming>
      <bpmn:outgoing>Fa_08</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Ta_cobrar" name="Cobrar el pedido (efectivo o POS)">
      <bpmn:incoming>Fa_08</bpmn:incoming>
      <bpmn:outgoing>Fa_09</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Ta_registrar" name="Registrar la venta en el software de ventas">
      <bpmn:incoming>Fa_09</bpmn:incoming>
      <bpmn:outgoing>Fa_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Ta_recibir" name="Recibir el pedido">
      <bpmn:incoming>Fa_10</bpmn:incoming>
      <bpmn:outgoing>Fa_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="Ev_fin" name="Pedido entregado">
      <bpmn:incoming>Fa_11</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fa_01" sourceRef="Ev_inicio" targetRef="Ta_caminar" />
    <bpmn:sequenceFlow id="Fa_02" sourceRef="Ta_caminar" targetRef="Ta_fila" />
    <bpmn:sequenceFlow id="Fa_03" sourceRef="Ta_fila" targetRef="Ta_indicar" />
    <bpmn:sequenceFlow id="Fa_04" sourceRef="Ta_indicar" targetRef="Ta_revisar" />
    <bpmn:sequenceFlow id="Fa_05" sourceRef="Ta_revisar" targetRef="Gw_stock" />
    <bpmn:sequenceFlow id="Fa_06" name="Sí" sourceRef="Gw_stock" targetRef="Ta_preparar" />
    <bpmn:sequenceFlow id="Fa_07" name="No" sourceRef="Gw_stock" targetRef="Ta_alternativa" />
    <bpmn:sequenceFlow id="Fa_13" sourceRef="Ta_alternativa" targetRef="Gw_alternativa" />
    <bpmn:sequenceFlow id="Fa_14" name="Sí" sourceRef="Gw_alternativa" targetRef="Ta_preparar" />
    <bpmn:sequenceFlow id="Fa_12" name="No" sourceRef="Gw_alternativa" targetRef="Ev_noventa" />
    <bpmn:sequenceFlow id="Fa_08" sourceRef="Ta_preparar" targetRef="Ta_cobrar" />
    <bpmn:sequenceFlow id="Fa_09" sourceRef="Ta_cobrar" targetRef="Ta_registrar" />
    <bpmn:sequenceFlow id="Fa_10" sourceRef="Ta_registrar" targetRef="Ta_recibir" />
    <bpmn:sequenceFlow id="Fa_11" sourceRef="Ta_recibir" targetRef="Ev_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true"><dc:Bounds x="140" y="80" width="1920" height="480" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_est_di" bpmnElement="Lane_est" isHorizontal="true"><dc:Bounds x="170" y="80" width="1890" height="200" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_ven_di" bpmnElement="Lane_ven" isHorizontal="true"><dc:Bounds x="170" y="280" width="1890" height="280" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ev_inicio_di" bpmnElement="Ev_inicio"><dc:Bounds x="260" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="218" y="204" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_caminar_di" bpmnElement="Ta_caminar"><dc:Bounds x="340" y="140" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_fila_di" bpmnElement="Ta_fila"><dc:Bounds x="510" y="140" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_indicar_di" bpmnElement="Ta_indicar"><dc:Bounds x="680" y="140" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_revisar_di" bpmnElement="Ta_revisar"><dc:Bounds x="800" y="330" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_stock_di" bpmnElement="Gw_stock" isMarkerVisible="true"><dc:Bounds x="990" y="345" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="955" y="305" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_alternativa_di" bpmnElement="Ta_alternativa"><dc:Bounds x="1060" y="450" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gw_alternativa_di" bpmnElement="Gw_alternativa" isMarkerVisible="true"><dc:Bounds x="1280" y="465" width="50" height="50" /><bpmndi:BPMNLabel><dc:Bounds x="1200" y="532" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ev_noventa_di" bpmnElement="Ev_noventa"><dc:Bounds x="1420" y="472" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1440" y="516" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_preparar_di" bpmnElement="Ta_preparar"><dc:Bounds x="1240" y="330" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_cobrar_di" bpmnElement="Ta_cobrar"><dc:Bounds x="1410" y="330" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_registrar_di" bpmnElement="Ta_registrar"><dc:Bounds x="1580" y="330" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ta_recibir_di" bpmnElement="Ta_recibir"><dc:Bounds x="1750" y="140" width="130" height="80" /></bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Ev_fin_di" bpmnElement="Ev_fin"><dc:Bounds x="1940" y="162" width="36" height="36" /><bpmndi:BPMNLabel><dc:Bounds x="1898" y="204" width="120" height="30" /></bpmndi:BPMNLabel></bpmndi:BPMNShape>
