<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" id="Definitions_1" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Camunda Modeler" exporterVersion="5.20.0">
  <bpmn:collaboration id="Collaboration_1">
    <bpmn:participant id="Participant_1" name="Venta de comida con pedidos anticipados y turnos (TO-BE)" processRef="Process_1" />
  </bpmn:collaboration>
  <bpmn:process id="Process_1" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_est" name="Estudiante">
        <bpmn:flowNodeRef>Ev_inicio</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_seleccionar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_pagar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_retirar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Ev_fin</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_sis" name="Sistema de turnos">
        <bpmn:flowNodeRef>Tb_verificar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gw_stock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_sinstock</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_registrar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_turno</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_notificar_v</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_avisar</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_ven" name="Vendedor del carrito">
        <bpmn:flowNodeRef>Tb_preparar</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_listo</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Tb_entrega</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Ev_inicio" name="Decide comprar durante la clase">
      <bpmn:outgoing>Fb_01</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Tb_seleccionar" name="Seleccionar productos en la app">
      <bpmn:incoming>Fb_01</bpmn:incoming>
      <bpmn:incoming>Fb_06</bpmn:incoming>
      <bpmn:outgoing>Fb_02</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Tb_verificar" name="Verificar stock disponible en tiempo real">
      <bpmn:incoming>Fb_02</bpmn:incoming>
      <bpmn:outgoing>Fb_03</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gw_stock" name="¿Hay stock suficiente?">
      <bpmn:incoming>Fb_03</bpmn:incoming>
      <bpmn:outgoing>Fb_04</bpmn:outgoing>
      <bpmn:outgoing>Fb_05</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Tb_sinstock" name="Informar productos sin stock y sugerir alternativas">
      <bpmn:incoming>Fb_05</bpmn:incoming>
      <bpmn:outgoing>Fb_06</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Tb_pagar" name="Confirmar el pedido y pagar en línea">
      <bpmn:incoming>Fb_04</bpmn:incoming>
      <bpmn:outgoing>Fb_07</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Tb_registrar" name="Registrar el pedido y descontar el stock">
      <bpmn:incoming>Fb_07</bpmn:incoming>
      <bpmn:outgoing>Fb_08</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Tb_turno" name="Asignar número de turno y hora estimada">
      <bpmn:incoming>Fb_08</bpmn:incoming>
      <bpmn:outgoing>Fb_09</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Tb_notificar_v" name="Enviar el pedido a la cola del vendedor">
      <bpmn:incoming>Fb_09</bpmn:incoming>
      <bpmn:outgoing>Fb_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Tb_preparar" name="Preparar el pedido según la cola de turnos">
      <bpmn:incoming>Fb_10</bpmn:incoming>
      <bpmn:outgoing>Fb_11</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Tb_listo" name="Marcar el pedido como listo">
      <bpmn:incoming>Fb_11</bpmn:incoming>
      <bpmn:outgoing>Fb_12</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Tb_avisar" name="Notificar al estudiante que su turno está listo">
      <bpmn:incoming>Fb_12</bpmn:incoming>
      <bpmn:outgoing>Fb_13</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Tb_retirar" name="Retirar el pedido mostrando su turno">
      <bpmn:incoming>Fb_13</bpmn:incoming>
      <bpmn:outgoing>Fb_14</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Tb_entrega" name="Confirmar la entrega en el sistema">
      <bpmn:incoming>Fb_14</bpmn:incoming>
      <bpmn:outgoing>Fb_15</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="Ev_fin" name="Pedido entregado sin fila">
      <bpmn:incoming>Fb_15</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Fb_01" sourceRef="Ev_inicio" targetRef="Tb_seleccionar" />
    <bpmn:sequenceFlow id="Fb_02" sourceRef="Tb_seleccionar" targetRef="Tb_verificar" />
    <bpmn:sequenceFlow id="Fb_03" sourceRef="Tb_verificar" targetRef="Gw_stock" />
    <bpmn:sequenceFlow id="Fb_04" name="Sí" sourceRef="Gw_stock" targetRef="Tb_pagar" />
    <bpmn:sequenceFlow id="Fb_05" name="No" sourceRef="Gw_stock" targetRef="Tb_sinstock" />
    <bpmn:sequenceFlow id="Fb_06" name="Reintentar" sourceRef="Tb_sinstock" targetRef="Tb_seleccionar" />
    <bpmn:sequenceFlow id="Fb_07" sourceRef="Tb_pagar" targetRef="Tb_registrar" />
    <bpmn:sequenceFlow id="Fb_08" sourceRef="Tb_registrar" targetRef="Tb_turno" />
    <bpmn:sequenceFlow id="Fb_09" sourceRef="Tb_turno" targetRef="Tb_notificar_v" />
    <bpmn:sequenceFlow id="Fb_10" sourceRef="Tb_notificar_v" targetRef="Tb_preparar" />
    <bpmn:sequenceFlow id="Fb_11" sourceRef="Tb_preparar" targetRef="Tb_listo" />
    <bpmn:sequenceFlow id="Fb_12" sourceRef="Tb_listo" targetRef="Tb_avisar" />
    <bpmn:sequenceFlow id="Fb_13" sourceRef="Tb_avisar" targetRef="Tb_retirar" />
    <bpmn:sequenceFlow id="Fb_14" sourceRef="Tb_retirar" targetRef="Tb_entrega" />
    <bpmn:sequenceFlow id="Fb_15" sourceRef="Tb_entrega" targetRef="Ev_fin" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="Collaboration_1">
      <bpmndi:BPMNShape id="Participant_1_di" bpmnElement="Participant_1" isHorizontal="true">
        <dc:Bounds x="140" y="80" width="2180" height="680" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_est_di" bpmnElement="Lane_est" isHorizontal="true">
