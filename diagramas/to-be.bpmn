      <bpmndi:BPMNShape id="Tb_preparar_di" bpmnElement="Tb_preparar">
        <dc:Bounds x="1440" y="620" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tb_listo_di" bpmnElement="Tb_listo">
        <dc:Bounds x="1610" y="620" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tb_avisar_di" bpmnElement="Tb_avisar">
        <dc:Bounds x="1780" y="320" width="130" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Tb_retirar_di" bpmnElement="Tb_retirar">
