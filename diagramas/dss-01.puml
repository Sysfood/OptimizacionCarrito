@startuml dss-01
skinparam defaultFontName DejaVu Sans
skinparam defaultFontSize 13
skinparam shadowing false
skinparam ArrowColor #333333
skinparam SequenceLifeLineBorderColor #888888
skinparam ParticipantBorderColor #1f4e79
skinparam ParticipantBackgroundColor #ffffff
skinparam ActorBorderColor #1f4e79
skinparam ActorBackgroundColor #ffffff
skinparam SequenceGroupBorderColor #8a6508
skinparam SequenceGroupHeaderFontColor #8a6508
skinparam NoteBorderColor #999999
skinparam NoteBackgroundColor #fffdf3
skinparam StateBorderColor #1f4e79
skinparam StateBackgroundColor #ffffff
skinparam StateStartColor #3a7d1f
skinparam StateEndColor #a33122
title DSS-01 — Pagar un pedido con reserva de unidades\n(CU-03 · HU-03, HU-04)

actor "Estudiante" as EST
participant "TurnoCarrito\n<<sistema>>" as SIS
participant "Pasarela de pago\n<<sistema externo>>" as PAS

EST -> SIS : iniciar pago (pedido con productos y cantidades)
SIS -> SIS : revalidar disponibilidad vendible

alt hay disponibilidad para todos los productos
  SIS -> SIS : reservar unidades (vencimiento 3 min)
  SIS -> PAS : solicitar cobro (total aceptado, referencia del pedido)
  PAS --> EST : solicitar datos de pago
  EST -> PAS : ingresar datos de pago
  PAS --> SIS : resultado del pago

  alt pago aprobado y reserva vigente
    SIS -> SIS : consumir reserva y registrar venta
    SIS -> SIS : asignar código de pedido y estimación informativa
    SIS --> EST : pedido confirmado (código, estado, estimación)
  else pago rechazado o pago cancelado
    SIS -> SIS : liberar reserva
    SIS --> EST : pago no realizado (selección conservada para reintentar)
  else vencimiento de reserva (3 min sin pago aprobado)
    SIS -> SIS : liberar reserva
    SIS --> EST : reserva vencida (reintentar exige nueva validación)
    opt pago aprobado tardío
      PAS --> SIS : resultado del pago (aprobado)
      SIS -> SIS : registrar pago en conciliación
      SIS --> EST : pago en resolución
    end
  end

else algún producto sin disponibilidad
  SIS --> EST : productos agotados y alternativas disponibles
end
@enduml
